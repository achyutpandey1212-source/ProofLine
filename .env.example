# Server Environment
NODE_ENV=development
PORT=5000

# MongoDB Database Connection
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/proofline?retryWrites=true&w=majority

# Firebase Admin Authentication
FIREBASE_PROJECT_ID=proofline-mvp
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@proofline-mvp.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Gemini Multimodal AI Provider (Pool of comma-separated keys)
GEMINI_API_KEYS=key1,key2,key3
GEMINI_MODEL=gemini-3.8-flash

# Groq Secondary / Fast Inference Provider (Pool of comma-separated keys)
GROQ_API_KEYS=key1,key2,key3
GROQ_MODEL=llama-3.3-70b-versatile

# ImageKit Storage Provider
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key_here
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key_here
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# Client / Frontend Origin
FRONTEND_URL=http://localhost:5173
